<div class="dashboard-header">
    <h2>ระบบมอนิเตอร์ความปลอดภัย (Security Monitor)</h2>
    <div class="refresh-info">
        <span id="lastUpdate">อัปเดตล่าสุด: กำลังโหลด</span>
        <button onclick="fetchSecurityData()" style="padding: 8px 15px; background: #1976D2; color: white; border: none; border-radius: 5px; cursor: pointer; margin-left: 10px;">
            <span class="material-icons" style="font-size: 16px; vertical-align: middle;">refresh</span> รีเฟรชข้อมูล
        </button>
    </div>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <h3>ประวัติ Log ทั้งหมดในระบบ</h3>
        <div class="value" id="statTotal">0</div>
    </div>
    <div class="stat-card danger">
        <h3>การ Login ล้มเหลว / ผิดปกติ (100 รายการล่าสุด)</h3>
        <div class="value" id="statFailed" style="color: #d32f2f;">0</div>
    </div>
</div>

<h3>⚠️ IP Address ที่น่าสงสัย (พบความพยายามเข้าระบบล้มเหลว)</h3>
<table class="monitor-table" id="ipTable">
    <thead>
        <tr>
            <th>IP Address</th>
            <th>จำนวน Request รวม</th>
            <th>พฤติกรรมล้มเหลว (ครั้ง)</th>
            <th>กิจกรรมล่าสุด</th>
            <th>จัดการ</th>
        </tr>
    </thead>
    <tbody>
        <tr><td colspan="5" style="text-align: center;">กำลังโหลดข้อมูล...</td></tr>
    </tbody>
</table>

<h3>📝 รายการความเคลื่อนไหวล่าสุด (Real-time Logs)</h3>
<table class="monitor-table" id="logTable">
    <thead>
        <tr>
            <th>วัน/เวลา</th>
            <th>ผู้ใช้งาน / IP</th>
            <th>กิจกรรม</th>
            <th>สถานะ</th>
        </tr>
    </thead>
    <tbody>
        <tr><td colspan="4" style="text-align: center;">กำลังโหลดข้อมูล...</td></tr>
    </tbody>
</table>

<style>
    .dashboard-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 30px; }
    .stat-card { background: white; padding: 20px; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); border-left: 5px solid #1976D2; }
    .stat-card.danger { border-left-color: #d32f2f; }
    .stat-card h3 { margin: 0 0 10px 0; font-size: 16px; color: #555; }
    .stat-card .value { font-size: 32px; font-weight: bold; color: #333; }
    .monitor-table { width: 100%; border-collapse: collapse; background: white; border-radius: 10px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.05); margin-bottom: 30px; }
    .monitor-table th, .monitor-table td { padding: 12px 15px; text-align: left; border-bottom: 1px solid #eee; }
    .monitor-table th { background-color: #1976D2; color: white; }
    .monitor-table tr:hover { background-color: #f9f9f9; }
    .btn-ban { background: #d32f2f; color: white; border: none; padding: 5px 10px; border-radius: 5px; cursor: pointer; }
    .btn-ban:hover { background: #b71c1c; }
    .badge-danger { background: #ffebee; color: #d32f2f; padding: 3px 8px; border-radius: 12px; font-size: 12px; }
    .refresh-info { font-size: 12px; color: #777; }
</style>

<script>
    async function fetchSecurityData() {
        document.getElementById('lastUpdate').innerText = 'อัปเดตล่าสุด: กำลังโหลด...';
        try {
            const res = await callApi("getSecurityDashboardData", { adminId: adminId, token: userToken });
            
            if (res.success) {
                document.getElementById('statTotal').innerText = res.stats.totalAnalyzed.toLocaleString();
                document.getElementById('statFailed').innerText = res.stats.recentFailed.toLocaleString();
                
                const ipTb = document.querySelector('#ipTable tbody');
                ipTb.innerHTML = '';
                const riskyIps = res.highRiskIps.filter(ip => ip.failedAttempts > 0);
                
                if (riskyIps.length === 0) {
                    ipTb.innerHTML = '<tr><td colspan="5" style="text-align:center;">ไม่พบ IP ที่มีความเสี่ยงในขณะนี้</td></tr>';
                } else {
                    riskyIps.forEach(item => {
                        const tr = ipTb.insertRow();
                        tr.insertCell().innerText = item.ip;
                        tr.insertCell().innerText = item.totalRequests;
                        tr.insertCell().innerHTML = `<span class="badge-danger">${item.failedAttempts} ครั้ง</span>`;
                        tr.insertCell().innerText = item.lastAction;
                        tr.insertCell().innerHTML = `<button class="btn-ban" onclick="banIp('${item.ip}')">แบน IP นี้</button>`;
                    });
                }

                const logTb = document.querySelector('#logTable tbody');
                logTb.innerHTML = '';
                res.logs.slice(0, 20).forEach(log => {
                    const tr = logTb.insertRow();
                    tr.insertCell().innerText = log.timestamp;
                    tr.insertCell().innerText = log.ipOrUser;
                    tr.insertCell().innerText = log.action;
                    
                    let statusColor = log.status.includes('ล้ม') || log.status.includes('Fail') ? 'color: red;' : 'color: green;';
                    tr.insertCell().innerHTML = `<span style="${statusColor}">${log.status}</span>`;
                });

                document.getElementById('lastUpdate').innerText = 'อัปเดตล่าสุด: ' + new Date().toLocaleTimeString('th-TH');
            } else {
                Swal.fire('ข้อผิดพลาด', res.message, 'error');
            }
        } catch (err) {
            Swal.fire('ข้อผิดพลาด', 'ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้', 'error');
        }
    }

    function banIp(ipAddress) {
        Swal.fire({
            title: `ยืนยันบล็อก IP: ${ipAddress}?`,
            text: "IP นี้จะไม่สามารถเข้าใช้งานระบบได้อีก",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            confirmButtonText: 'ยืนยันบล็อก'
        }).then(async (result) => {
            if (result.isConfirmed) {
                Swal.fire({ title: 'กำลังประมวลผล...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                try {
                    const res = await callApi("blockIpAddress", { ipAddress: ipAddress, adminId: adminId, token: userToken });
                    if (res.success) {
                        Swal.fire('สำเร็จ', res.message, 'success');
                        fetchSecurityData();
                    } else {
                        Swal.fire('แจ้งเตือน', res.message, 'warning');
                    }
                } catch (err) {
                    Swal.fire('ข้อผิดพลาด', err.message, 'error');
                }
            }
        });
    }

    let securityMonitorInterval;
    function startSecurityMonitor() {
        fetchSecurityData();
        if (securityMonitorInterval) clearInterval(securityMonitorInterval);
        securityMonitorInterval = setInterval(fetchSecurityData, 60000);
    }
</script>
